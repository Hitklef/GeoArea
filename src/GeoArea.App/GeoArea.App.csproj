<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GeoArea.App</RootNamespace>
    <AssemblyName>GeoArea</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>GeoArea</Product>
    <AssemblyTitle>GeoArea — обчислення площі ділянки за координатами</AssemblyTitle>
    <Version>1.0.0</Version>
    <Company>Dressler Consulting</Company>
    <NeutralLanguage>uk-UA</NeutralLanguage>

    <!-- Параметри публікації одним exe-файлом передає publish.cmd; тут лише те, що не заважає звичайній збірці у Visual Studio. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>uk;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoArea.Core\GeoArea.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
