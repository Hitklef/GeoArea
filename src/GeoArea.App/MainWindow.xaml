<Window x:Class="GeoArea.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GeoArea.App.ViewModels"
        Title="GeoArea — обчислення площі ділянки за координатами"
        Width="1280" Height="900" MinWidth="720" MinHeight="520"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel x:Name="RootPanel">
        <!-- Масштабування: коли вікно менше за базовий розмір 1280×900, увесь вміст
             пропорційно зменшується (див. Window_SizeChanged), і зовнішній скрол не потрібен. -->
        <DockPanel.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </DockPanel.LayoutTransform>

        <!-- ===== Верхня панель ===== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Neutral}" Height="36" Click="Help_Click"
                        ToolTip="Відкриває коротку інструкцію: як ввести координати, що означають стовпці відомості та як надрукувати результат.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="?" FontWeight="Bold" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Довідка" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M4,18 L8,5 L14,14 L17,8 L20,18 Z" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="GeoArea — обчислення площі ділянки за координатами" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Смуга з підказкою ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.HintBack}" BorderBrush="{StaticResource Brush.HintBorder}" BorderThickness="0,0,0,1" Padding="14,8">
            <TextBlock Foreground="{StaticResource Brush.AccentDark}" TextWrapping="Wrap">
                <Run FontWeight="Bold" Text="Підказка:" />
                <Run Text="наведіть мишу на будь-яку кнопку або поле і затримайте на секунду — з'явиться пояснення, що воно робить. Під кожною кнопкою також є короткий опис." />
            </TextBlock>
        </Border>

        <!-- ===== Рядок стану ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="GeoArea 1.0" Foreground="{StaticResource Brush.TextHint}" FontSize="13" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="13" TextTrimming="CharacterEllipsis"
                           ToolTip="Тут завжди написано, що зараз відбувається і чи є результат." />
            </DockPanel>
        </Border>

        <!-- ===== Основний вміст ===== -->
        <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="11*" MinHeight="300" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="9*" MinHeight="220" />
                </Grid.RowDefinitions>

                <!-- ===== КРОК 1: координати ===== -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepBadgeText}" /></Border>
                            <TextBlock Text="Введіть координати вершин ділянки" Style="{StaticResource Text.Title}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource Text.Muted}" Margin="0,0,0,14"
                                   Text="Для кожної точки (вершини) ділянки введіть координати X та Y у метрах. Точки вводьте по порядку обходу межі — за годинниковою стрілкою або проти, як зручно. Десятковий роздільник — кома або крапка, обидва варіанти підходять." />

                        <!-- Кнопки дій -->
                        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,5,0">
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding AddPointCommand}" Content="+ Додати точку"
                                        ToolTip="Додає порожній рядок у кінець таблиці, щоб ввести ще одну вершину ділянки." />
                                <TextBlock Text="Новий рядок у таблиці" Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                            <StackPanel Margin="5,0">
                                <Button Style="{StaticResource Button.Secondary}" Click="Paste_Click" Content="Вставити з буфера"
                                        ToolTip="Відкриває поле, куди можна вставити список координат, скопійований з Excel, Word або текстового файлу (Ctrl+V). Програма сама розпізнає числа." />
                                <TextBlock Text="Скопійовані з Excel дані" Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                            <StackPanel Margin="5,0">
                                <Button Style="{StaticResource Button.Secondary}" Click="OpenFile_Click" Content="Відкрити файл"
                                        ToolTip="Відкриває вікно вибору файлу. Підходять файли .txt та .csv, де в кожному рядку записані X та Y однієї точки." />
                                <TextBlock Text="Файл .txt або .csv" Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                            <StackPanel Margin="5,0,0,0">
                                <Button Style="{StaticResource Button.Neutral}" Click="ClearAll_Click" Content="Очистити все"
                                        ToolTip="Видаляє всі введені точки, щоб почати нову ділянку з чистої таблиці. Перед видаленням програма перепитає." />
                                <TextBlock Text="Почати заново" Style="{StaticResource Text.Hint}" />
                            </StackPanel>
                        </UniformGrid>

                        <!-- Поле вставки з буфера -->
                        <Border Grid.Row="3" Visibility="{Binding IsPasteOpen, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource Brush.TableSum}" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Вставте сюди скопійовані координати (Ctrl+V)" />
                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,4,0,8"
                                           Text="Кожна точка — з нового рядка. Між X та Y може бути пробіл, кома, крапка з комою або табуляція. Номер точки на початку рядка не обов'язковий — програма його пропустить." />
                                <TextBox x:Name="PasteBox" Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True" MinHeight="90" MaxHeight="160"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="6"
                                         BorderBrush="{StaticResource Brush.Border}"
                                         ToolTip="Клацніть сюди і натисніть Ctrl+V, щоб вставити скопійований список координат." />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource Button.Success}" Click="ApplyPaste_Click" Content="Додати ці точки в таблицю"
                                            ToolTip="Розпізнає числа у вставленому тексті та додає їх у таблицю як нові точки." />
                                    <Button Style="{StaticResource Button.Neutral}" Height="40" FontSize="14" Margin="10,0,0,0" Click="CancelPaste_Click" Content="Скасувати"
                                            ToolTip="Закриває це поле, нічого не додаючи." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Таблиця точок: заголовок зверху, список займає решту висоти і прокручується всередині -->
                        <Border Grid.Row="4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" VerticalAlignment="Stretch">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Background="{StaticResource Brush.TableHeader}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="№" FontWeight="SemiBold" TextAlignment="Center" Padding="6"
                                               ToolTip="Порядковий номер вершини. Порядок має значення — це порядок обходу межі." />
                                    <TextBlock Grid.Column="1" Text="X, м" FontWeight="SemiBold" TextAlignment="Center" Padding="6"
                                               ToolTip="Координата X у метрах. Може бути від'ємною — тоді ставте мінус перед числом." />
                                    <TextBlock Grid.Column="2" Text="Y, м" FontWeight="SemiBold" TextAlignment="Center" Padding="6"
                                               ToolTip="Координата Y у метрах. Може бути від'ємною — тоді ставте мінус перед числом." />
                                    <TextBlock Grid.Column="3" Text="Дії" FontWeight="SemiBold" TextAlignment="Center" Padding="6"
                                               ToolTip="Кнопки для зміни порядку точок та видалення." />
                                </Grid>
                                <!-- Власна прокрутка: при багатьох точках прокручується лише таблиця, а не все вікно -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              ToolTip="Якщо точок багато, таблицю можна прокручувати коліщатком миші.">
                                <ItemsControl ItemsSource="{Binding Points}" x:Name="PointsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PointRowViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Grid.ColumnSpan="4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" />
                                                <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource Cell.Center}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource Input.Coordinate}"
                                                         Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="{Binding XState}"
                                                         PreviewKeyDown="CoordinateBox_PreviewKeyDown"
                                                         ToolTip="Введіть координату X цієї точки. Enter — перейти до наступного поля." />
                                                <TextBox Grid.Column="2" Style="{StaticResource Input.Coordinate}"
                                                         Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="{Binding YState}"
                                                         PreviewKeyDown="CoordinateBox_PreviewKeyDown"
                                                         ToolTip="Введіть координату Y цієї точки. Enter — перейти до наступного поля." />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Button.RowAction}" Content="▲"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Перемістити цю точку на один рядок вище." />
                                                    <Button Style="{StaticResource Button.RowAction}" Content="▼"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Перемістити цю точку на один рядок нижче." />
                                                    <Button Style="{StaticResource Button.RowDelete}" Content="✕"
                                                            Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Видалити цю точку з таблиці." />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <TextBlock Grid.Row="5" Style="{StaticResource Text.Muted}" FontSize="13" Margin="0,10,0,0">
                            <Run Text="Рядків у таблиці:" /><Run Text=" " /><Run FontWeight="Bold" Text="{Binding PointCountText, Mode=OneWay}" /><Run Text=". Для розрахунку потрібно щонайменше 3 точки. Площа перераховується автоматично після кожної зміни — окрему кнопку «Порахувати» натискати не треба." />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ===== КРОК 2: результат ===== -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <!-- Якщо висоти не вистачає, прокручується лише ця картка -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepBadgeText}" /></Border>
                            <TextBlock Text="Результат" Style="{StaticResource Text.Title}" />
                        </StackPanel>

                        <!-- Є результат -->
                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <Border Background="{StaticResource Brush.OkBack}" BorderBrush="{StaticResource Brush.OkBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Площа ділянки" Foreground="{StaticResource Brush.OkText}" />
                                    <TextBlock Foreground="{StaticResource Brush.OkTextDark}" FontSize="36" FontWeight="Bold" Margin="0,4,0,0"
                                               ToolTip="Площа в квадратних метрах, округлена до 0,01 м².">
                                        <Run Text="{Binding AreaSquareMetersText, Mode=OneWay}" /><Run Text=" м²" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource Brush.OkText}" FontSize="20" Margin="0,2,0,0"
                                               ToolTip="Та сама площа в гектарах (1 га = 10 000 м²), округлена до 0,0001 га.">
                                        <Run Text="= " /><Run Text="{Binding AreaHectaresText, Mode=OneWay}" /><Run Text=" га" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Контроль -->
                            <Border Margin="0,10,0,0" CornerRadius="8" Padding="12"
                                    ToolTip="Перевірка правильності: сума стовпця 8 має збігатися із сумою стовпця 9, а суми стовпців 6 і 7 мають дорівнювати нулю.">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.OkBack}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ControlPassed}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource Brush.WarnBack}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="24" FontSize="18" FontWeight="Bold" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                                <Setter Property="Text" Value="✓" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ControlPassed}" Value="False">
                                                        <Setter Property="Text" Value="!" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ControlText}" TextWrapping="Wrap" MaxWidth="420" Foreground="{StaticResource Brush.OkText}" />
                                </StackPanel>
                            </Border>

                            <!-- Попередження -->
                            <Border Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                                    Margin="0,10,0,0" Background="{StaticResource Brush.WarnBack}" BorderBrush="{StaticResource Brush.WarnBorder}" BorderThickness="1" CornerRadius="8" Padding="12"
                                    ToolTip="Зауваження до введених точок. Площа порахована, але варто перевірити дані.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="!" Width="24" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.WarnText}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" MaxWidth="420" Foreground="{StaticResource Brush.WarnText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Немає результату -->
                        <Border Visibility="{Binding HasNoResult, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource Brush.WarnBack}" BorderBrush="{StaticResource Brush.WarnBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="!" Width="24" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.WarnText}" VerticalAlignment="Top" />
                                <TextBlock MaxWidth="420" TextWrapping="Wrap" Foreground="{StaticResource Brush.WarnText}">
                                    <Run FontWeight="Bold" Text="Поки що немає результату. " /><Run Text="{Binding MessageText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Як це рахується -->
                        <TextBlock FontWeight="SemiBold" Margin="0,16,0,4" Text="Як це рахується" />
                        <TextBlock Style="{StaticResource Text.Muted}"
                                   Text="Програма використовує формулу Гаусса: координати кожної точки множаться на різницю координат сусідніх точок, усе додається і ділиться на 2. Рахунок ведеться двома способами одночасно (стовпці 8 і 9 відомості) — якщо вони збігаються, помилки немає." />

                        <!-- Налаштування -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Налаштування" Margin="0,0,0,6" />
                                <DockPanel Margin="0,0,0,8" ToolTip="Скільки знаків після коми показувати в обчислених стовпцях відомості (6–9). На точність площі це не впливає.">
                                    <ComboBox DockPanel.Dock="Right" Width="70" Height="36" FontSize="14"
                                              ItemsSource="{Binding DecimalsOptions}" SelectedItem="{Binding Decimals}" />
                                    <TextBlock Text="Знаків після коми у відомості" VerticalAlignment="Center" />
                                </DockPanel>
                                <CheckBox IsChecked="{Binding IgnoreClosingDuplicate}" FontSize="14"
                                          ToolTip="Якщо остання точка збігається з першою (контур «замкнули» вручну), програма не рахуватиме її двічі.">
                                    <TextBlock Text="Не враховувати повторно першу точку в кінці списку" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===== КРОК 3: відомість ===== -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                                <StackPanel Margin="0,0,10,6">
                                    <Button Style="{StaticResource Button.Secondary}" Click="CopyTable_Click" Content="Копіювати таблицю" IsEnabled="{Binding HasResult}" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Копіює всю таблицю відомості в буфер обміну. Потім її можна вставити у Word або Excel через Ctrl+V." />
                                    <TextBlock Text="Для вставки у Word / Excel" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,6">
                                    <Button Style="{StaticResource Button.Secondary}" Click="SaveWord_Click" Content="Зберегти у Word" IsEnabled="{Binding HasResult}" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Зберігає заповнену відомість як файл Word (.docx) у вигляді, як у бланку. Програма запитає, куди зберегти файл." />
                                    <TextBlock Text="Файл .docx на диску" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <Button Style="{StaticResource Button.Secondary}" Click="Print_Click" Content="Друкувати" IsEnabled="{Binding HasResult}" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Відкриває стандартне вікно друку Windows і друкує відомість на принтері." />
                                    <TextBlock Text="На принтер" Style="{StaticResource Text.Hint}" />
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepBadgeText}" /></Border>
                                <TextBlock Text="Відомість обчислення площі по координатам точок вершин" Style="{StaticResource Text.Title}" TextWrapping="Wrap" MaxWidth="620" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource Text.Muted}" Margin="0,0,0,12"
                                   Text="Ця таблиця заповнюється автоматично і повторює стандартний бланк. Стовпці 6–9 — проміжні обчислення; у рядку «Сума» видно, що суми стовпців 8 і 9 збігаються, а стовпців 6 і 7 — дорівнюють нулю. Це і є перевірка правильності." />

                        <!-- Таблиця займає всю решту висоти картки і прокручується всередині;
                             "зіркові" стовпці розтягуються на всю ширину (жодного зовнішнього ScrollViewer). -->
                                <DataGrid Grid.Row="2" Style="{StaticResource Worksheet}" ItemsSource="{Binding WorksheetRows}" x:Name="WorksheetGrid"
                                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                                          VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          EnableRowVirtualization="True"
                                          ToolTip="Готова відомість. Якщо точок багато — прокручуйте коліщатком миші. Скопіювати, зберегти у Word або надрукувати можна кнопками праворуч угорі.">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="№ п/п&#x0a;(1)" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Number}" Style="{StaticResource Cell.Center}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="X&#x0a;(3)" Width="1.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding X}" Style="{StaticResource Cell.Number}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Y&#x0a;(5)" Width="1.1*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Y}" Style="{StaticResource Cell.Number}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Xn−1 − Xn+1&#x0a;(6)" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DeltaX}" Style="{StaticResource Cell.Number}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Yn+1 − Yn−1&#x0a;(7)" Width="1.2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DeltaY}" Style="{StaticResource Cell.Number}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="(Xn−1 − Xn+1)·Yn&#x0a;(8)" Width="1.6*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Product8}" Style="{StaticResource Cell.Number}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="(Yn+1 − Yn−1)·Xn&#x0a;(9)" Width="1.6*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Product9}" Style="{StaticResource Cell.Number}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Підсумки (ширини стовпців синхронізуються в коді з DataGrid) -->
                                <Grid Grid.Row="3" x:Name="SumsGrid" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.6*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SumCell}" BorderThickness="1,0,1,1"><TextBlock Text="Сума" Style="{StaticResource SumText}" TextAlignment="Center" /></Border>
                                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource SumCell}" ToolTip="Сума стовпця 6. Має дорівнювати нулю."><TextBlock Text="{Binding Sum6Text}" Style="{StaticResource SumText}" /></Border>
                                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource SumCell}" ToolTip="Сума стовпця 7. Має дорівнювати нулю."><TextBlock Text="{Binding Sum7Text}" Style="{StaticResource SumText}" /></Border>
                                    <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource SumCell}" ToolTip="Подвоєна площа 2P за першим способом."><TextBlock Text="{Binding Sum8Text}" Style="{StaticResource SumText}" /></Border>
                                    <Border Grid.Row="0" Grid.Column="6" Style="{StaticResource SumCell}" ToolTip="Подвоєна площа 2P за другим способом — має збігатися зі стовпцем 8."><TextBlock Text="{Binding Sum9Text}" Style="{StaticResource SumText}" /></Border>

                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SumCell}" BorderThickness="1,0,1,1"><TextBlock Text="Подвоєна площа 2P, м²" Style="{StaticResource SumText}" TextAlignment="Center" /></Border>
                                    <Border Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4" Style="{StaticResource SumCell}" ToolTip="2P — сума стовпця 8 (або 9) без знака. Площа P = 2P / 2."><TextBlock Text="{Binding DoubleAreaText}" Style="{StaticResource SumText}" TextAlignment="Center" /></Border>

                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SumCell}" BorderThickness="1,0,1,1"><TextBlock Text="Площа P = 2P / 2" Style="{StaticResource SumText}" TextAlignment="Center" /></Border>
                                    <Border Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="4" Style="{StaticResource SumCell}">
                                        <TextBlock Style="{StaticResource SumText}" TextAlignment="Center" Foreground="{StaticResource Brush.OkTextDark}">
                                            <Run Text="{Binding AreaSquareMetersText, Mode=OneWay}" /><Run Text=" м² = " /><Run Text="{Binding AreaHectaresText, Mode=OneWay}" /><Run Text=" га" />
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="4" Visibility="{Binding HasNoResult, Converter={StaticResource BoolToVis}}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                                           Text="Відомість з'явиться тут, щойно буде введено щонайменше три точки без помилок." />
                    </Grid>
                </Border>
        </Grid>
    </DockPanel>
</Window>
